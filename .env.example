# Copy to .env (never commit it) or set these in your host's dashboard.
NODE_ENV=production
PORT=3000

# Public URL of the site (no trailing slash). Used at BUILD time for canonical/Open Graph/sitemap.
SITE_URL=https://your-domain.example

# Contact form email via Resend (https://resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
CONTACT_TO=info@nerva-tech.com
CONTACT_FROM=NervaTech Website <no-reply@your-domain.example>
# Set to true to also email an acknowledgement to the person who submitted the form.
CONTACT_ACK=false

# Set to 1 only when running behind a trusted reverse proxy/load balancer (so rate limiting sees real client IPs).
TRUST_PROXY=0
